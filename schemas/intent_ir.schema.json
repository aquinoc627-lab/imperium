{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/aquinoc627-lab/imperium/schemas/intent_ir.schema.json",
  "title": "IntentIR",
  "description": "IMPERIUM Intent Intermediate Representation (protocol version 1). Canonical contract for Rust and Python.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "nl_source",
    "goal",
    "constraints",
    "success_criteria",
    "tasks",
    "risk_score",
    "requires_approval",
    "version"
  ],
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "name": { "type": "string", "minLength": 1 },
    "nl_source": { "type": "string" },
    "goal": { "$ref": "#/$defs/Goal" },
    "constraints": {
      "type": "array",
      "items": { "$ref": "#/$defs/Constraint" }
    },
    "success_criteria": {
      "type": "array",
      "items": { "$ref": "#/$defs/SuccessCriterion" }
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/Task" }
    },
    "risk_score": { "type": "number", "minimum": 0, "maximum": 1 },
    "requires_approval": { "type": "boolean" },
    "version": { "type": "integer", "const": 1 },
    "compiled_at": { "type": "string", "format": "date-time" },
    "compiler_version": { "type": "string" }
  },
  "$defs": {
    "Goal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description", "category", "priority"],
      "properties": {
        "description": { "type": "string" },
        "category": {
          "type": "string",
          "enum": [
            "CodeGeneration",
            "Refactoring",
            "Migration",
            "Deployment",
            "Investigation",
            "Automation",
            "Analysis",
            "Custom"
          ]
        },
        "priority": {
          "type": "string",
          "enum": ["Low", "Normal", "High", "Critical"]
        }
      }
    },
    "Constraint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "severity"],
      "properties": {
        "id": { "type": "string" },
        "kind": {
          "type": "string",
          "enum": [
            "ZeroDowntime",
            "BudgetLimit",
            "Compliance",
            "SecurityReview",
            "BackwardCompatibility",
            "PerformanceTarget",
            "DataResidency",
            "Custom"
          ]
        },
        "parameters": { "type": "object" },
        "severity": { "type": "string", "enum": ["Hard", "Soft", "Advisory"] }
      }
    },
    "SuccessCriterion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "metric", "threshold"],
      "properties": {
        "id": { "type": "string" },
        "metric": {
          "type": "string",
          "enum": [
            "TestPassRate",
            "LatencyP50",
            "LatencyP99",
            "ErrorRate",
            "Throughput",
            "CostPerHour",
            "MemoryUsage",
            "CPUUsage",
            "SecurityScore",
            "ComplianceScore",
            "Custom"
          ]
        },
        "threshold": { "$ref": "#/$defs/Threshold" },
        "weight": { "type": "number" }
      }
    },
    "Threshold": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operator", "value", "unit"],
      "properties": {
        "operator": {
          "type": "string",
          "enum": [
            "LessThan",
            "LessThanOrEqual",
            "GreaterThan",
            "GreaterThanOrEqual",
            "Equal",
            "NotEqual"
          ]
        },
        "value": { "type": "number" },
        "unit": { "type": "string" }
      }
    },
    "Task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "description", "kind"],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "kind": {
          "type": "string",
          "enum": [
            "Discovery",
            "Design",
            "CodeGeneration",
            "Testing",
            "Simulation",
            "Deployment",
            "Verification",
            "Rollback",
            "Notification",
            "Custom"
          ]
        },
        "capabilities": {
          "type": "array",
          "items": { "type": "string" }
        },
        "dependencies": {
          "type": "array",
          "items": { "type": "string", "format": "uuid" }
        },
        "estimated_duration_ms": { "type": ["integer", "null"], "minimum": 0 },
        "retry_policy": { "$ref": "#/$defs/RetryPolicy" },
        "compensation": {
          "anyOf": [{ "$ref": "#/$defs/CompensationAction" }, { "type": "null" }]
        }
      }
    },
    "RetryPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_attempts": { "type": "integer", "minimum": 1 },
        "backoff_ms": { "type": "integer", "minimum": 0 },
        "backoff_multiplier": { "type": "number" },
        "max_backoff_ms": { "type": "integer", "minimum": 0 },
        "retryable_errors": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "CompensationAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action_type", "target_task", "payload"],
      "properties": {
        "action_type": {
          "type": "string",
          "enum": ["Undo", "Reverse", "Compensate", "Notify"]
        },
        "target_task": { "type": "string", "format": "uuid" },
        "payload": { "type": "object" }
      }
    }
  }
}
